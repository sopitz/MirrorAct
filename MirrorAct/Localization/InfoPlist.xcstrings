    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorAct ist als AirPlay-Empfänger für die Bildschirmsynchronisierung erreichbar und kann mit einem Sprachmodell auf einem Computer im lokalen Netzwerk übersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MirrorAct can be reached as an AirPlay receiver for Screen Mirroring and can translate with a language model on a computer in the local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地网络中的设备可通过 AirPlay 连接到 MirrorAct 进行屏幕镜像。MirrorAct 也可使用本地网络中其他电脑上的语言模型进行翻译。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorAct gibt den Ton eines per Kabel verbundenen iPhones oder iPads wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MirrorAct plays the sound of an iPhone or iPad connected by cable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorAct 用于播放通过线缆连接的 iPhone 或 iPad 声音。"
          }
        }
      }
    }
