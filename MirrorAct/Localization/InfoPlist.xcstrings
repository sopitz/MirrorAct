    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorAct zeigt den Bildschirm eines per Kabel verbundenen iPhones oder iPads an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MirrorAct shows the screen of an iPhone or iPad connected by cable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorAct 用于显示通过线缆连接的 iPhone 或 iPad 屏幕。"
          }
        }
      }
    },
