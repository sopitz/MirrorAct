    "Cable: connect and unlock the iPhone, then choose this again.\n\nWireless: on the iPhone, open Control Center → Screen Mirroring → “%@”. Code: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per Kabel: iPhone anschliessen und entsperren, dann hier erneut wählen.\n\nKabellos: Auf dem iPhone Kontrollzentrum → Bildschirmsynchronisierung → «%1$@» wählen. Code: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cable: connect and unlock the iPhone, then choose this again.\n\nWireless: on the iPhone, open Control Center → Screen Mirroring → “%1$@”. Code: %2$@"
          }
        }
      }
